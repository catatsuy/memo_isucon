[mysqld]

## 基本設定
# DNS逆引きを省略。MySQLユーザーのHost指定にホスト名を使っていないか確認する。
skip_name_resolve=ON

# ロック競合が問題なら検討。ただしREPEATABLE-READからの変更はアプリの意味論にも影響。
# READ-COMMITTEDでは通常のギャップロックの扱いや一貫性読み取りが変わる。
# transaction_isolation=READ-COMMITTED

## network
# 接続数のピーク(Max_used_connections)と各スレッドのメモリを確認。2000は大きい。
max_connections=2000
# 大きなBLOB等を扱うなら増やす
max_allowed_packet=300M
# 接続エラーの許容回数。通常は性能改善にならない。
max_connect_errors=10000

# 接続の作成・破棄が多いとき。Threads_createdやThreads_cachedを確認。
# thread_cache_size=100
# テーブルの開閉が多いとき。Opened_tablesやOpen_tablesを確認。
# table_open_cache=8000

## innodb
## refs: https://www.percona.com/blog/innodb-performance-optimization-basics-updated
innodb_buffer_pool_size=1G

# 5.7/8.0では既定16M、8.4では既定64M。
# innodb_log_buffer_size=64M

# 【8.0.30以降】redo log全体の容量。5.7 / 8.0.29以前では未対応。
# 大きいほど書き込みピークを吸収しやすいが、ディスク容量・回復時間に注意。
# innodb_redo_log_capacity=2048M

# 8.0.30で非推奨化。8.0.30以降にredo_log_capacityがあればそちらを優先。
# 元の512M設定では 512M x 2 = 計1G。計2Gに合わせるなら1024M x 2。
# innodb_log_file_size=1024M
# innodb_log_files_in_group=2

# ロック待ちが長く詰まる場合は短縮。ただしロールバック/リトライが増える可能性。
# innodb_lock_wait_timeout=5

## for ISUCON（危険: データの安全性より短時間のスコアを優先する場合のみ）
# doublewrite無効化。部分書き込み等からのリカバリができなくなる危険。
innodb_doublewrite=0

# O_DIRECT_NO_FSYNCはwrite後のfsyncを省略。O_DIRECTと必ず比較する。
# 8.0系以前の既定はUnixでfsync、8.4のLinux等ではO_DIRECT（対応環境）。
# 古い8.0系（8.0.14より前）+ XFS/ext4ではメタデータ永続化に注意。
# データ/redoを異なるデバイスに置く場合など、クラッシュ時の消失リスクにも注意。
innodb_flush_method=O_DIRECT_NO_FSYNC
# innodb_flush_method=O_DIRECT

# コミット毎のredo logのディスク同期を省略。クラッシュ時にコミット済みデータを失いうる。
innodb_flush_log_at_trx_commit=0

# 【8.0.20以降】doublewrite有効時だけ意味がある。
# 8.0.20～8.0.xの既定はinnodb_write_io_threadsの値（通常4）。
# 8.4では既定128なので、設定する必要は通常ない。
# refs: https://www.percona.com/blog/surprise-with-innodb_doublewrite_pages-in-mysql-8-0-20/
# innodb_doublewriteを無効にしているなら関係ない。
# innodb_doublewrite_pages=128

## for SSD
# 5.7では既定1、8.0/8.4では既定0。HDDなら1/2も選択肢。
innodb_flush_neighbors=0
# 5.7/8.0/8.4で既定OFF。シーケンシャルでない先読みは通常不要。
# innodb_random_read_ahead=OFF
# 5.7/8.0/8.4で既定56。先読みのヒット状況を見て調整。
# innodb_read_ahead_threshold=56

# 【8.0.22以降】低並列ならOFFの方が有利な可能性がある。
# 高QPS・高並列ではONが有利な場合がある。既定はON。
# refs: https://qiita.com/hmatsu47/items/06489ef05bfcaaf310f3
# innodb_log_writer_threads=OFF

## 一時ファイル・一時テーブル
# OS側で /dev/shm を十分に確保しておくこと。
# tmpdirのディレクトリをmysqld起動前に作成し、mysqlユーザーに書込権限を与える。
# tmpdir はソート等の一時ファイルとTempTableのmmap一時ファイル等に使われる。
# 8.0/8.4でInnoDBにディスク化した内部一時テーブル全体がここへ移るわけではない。
# /dev/shmが満杯になるとクエリ失敗等が起こりうる。アプリと同居ならメモリ競合にも注意。
# 複数パスは「フォールバック」ではなくラウンドロビンなので、片方が満杯でも自動救済されない。
# tmpdir=/dev/shm/mysqltmp
# tmpdir=/dev/shm/mysqltmp:/tmp

# 【8.0.2以降】既定はTempTable。5.7では存在しない。
# internal_tmp_mem_storage_engine=TempTable

# 【5.7/8.0/8.4】既定16M。8.0.28以降ではTempTableの個別メモリ一時テーブル上限。
# 5.7や古い8.0ではMEMORYエンジン等での意味が異なる。並列時のメモリ増加に注意。
# tmp_table_size=64M
# MEMORYを使う場合はtmp_table_sizeとの小さい方が内部一時テーブルの上限となる。
# TempTableにはmax_heap_table_sizeは適用されない。
# max_heap_table_size=64M

# 【8.0.2以降】TempTableが使用するRAM合計の上限。
# 8.0では既定1G。8.4ではRAM全体の3%（最小1G、最大4G）が既定。
# 8.4で1G固定にすると、環境によっては既定値より減らすことになる。
# temptable_max_ram=1G

# 【8.0.16以降】旧方式。8.0.26以降非推奨、8.4の既定はOFF。
# 8.4でtemptable_max_mmap=0のままONを指定してもmmapは使われない。
# temptable_use_mmap=ON

# 【8.0.23以降】TempTableのmmap一時ファイルに許容する上限。
# 8.0の既定1G、8.4の既定0（mmap無効）。/dev/shmを使うなら容量とセットで検討。
# temptable_max_mmap=1G
# temptable_max_mmap=0

# 【8.0.13以降】セッション一時テーブルスペースの場所を変えたい場合だけ。
# tmpdirとは別用途。配置先の容量・権限・起動時の扱いを確認。
# innodb_temp_tablespaces_dir=./#innodb_temp

## 解析系
# スコア測定時のオーバーヘッド削減候補。ただしsys等の計測機能が使えなくなる。
performance_schema=OFF
# 調査時には必要に応じてON。再起動が必要。
# performance_schema=ON

## 再起動時のinnodb_buffer_pool復帰
# 5.7/8.0/8.4では通常dump/loadが既定ON。明示したい場合に残しておく。
innodb_buffer_pool_dump_at_shutdown=1
innodb_buffer_pool_load_at_startup=1
# 既定は25%。100なら全ページIDを対象とするが、復元時間・I/Oも確認。
innodb_buffer_pool_dump_pct=100

## binlogを切る
skip-log-bin
# sync_binlog=0
# レプリケーションのrelay log専用。レプリカでなければ不要。
# sync_relay_log=0

## MySQL 8.0 only
## refs: https://dba.stackexchange.com/questions/216352/inserts-in-mysql-8-are-slower-than-inserts-in-mysql-5-7
# transaction_write_set_extraction は8.0系の古い実装向け。
# 8.3以降で削除済み。8.4に書くと起動失敗の原因となりうる。
# transaction_write_set_extraction=OFF

## for slow query
# 全クエリ記録は調査用。ベンチ本番ではログ出力負荷がスコアに影響するのでOFF推奨。
slow_query_log=1
# 【8.0.14以降】FILE出力の追加情報。5.7/8.0.13以前では未対応。
# log_slow_extra=1
# FILEへ出す場合に明示したければ指定する（既定もFILE）。
# log_output=FILE
slow_query_log_file=/var/log/mysql/slow.log
long_query_time=0
# ファイルの配置先とmysqlユーザーの権限、ディスク空き容量を確認。

## dangerous
# ページの整合性検知を捨てる。I/O削減効果より破損検知不能のリスクが大きい。
# innodb_checksum_algorithm=none

## 多コア・高QPS向け
# 【8.0.22以降】多コア・高並列ではredo log専用スレッドをONに戻して比較。
# innodb_log_writer_threads=ON

# 【8.0.30以降】書込みピークが長く息切れするなら容量を拡大（2→4→8G）。
# redo容量を増やしてもストレージ容量・クラッシュ復旧時間とのトレードオフ。
# innodb_redo_log_capacity=4096M
# innodb_redo_log_capacity=8192M
# 【5.7～8.0.29】同じ総容量にしたい場合はlog_file_size x 2で指定。
# innodb_log_file_size=2048M  # 総容量4G
# innodb_log_file_size=4096M  # 総容量8G

# SSD/NVMeの実効IOPSとフラッシュ負荷を見て調整。過大は逆効果もあり計測必須。
# 5.7/8.0の既定はinnodb_io_capacity=200、8.4では10000。
# 8.4では下記の2000/4000は「引き上げ」ではなく「引き下げ」になる。
# innodb_io_capacity=2000
# innodb_io_capacity_max=4000

# バッファプールが大きく、競合がある場合に検討。
# 1インスタンス当たり1G以上を目安にする。buffer_pool_size=1Gなら原則不要。
# 8.0は既定8（1G未満では1）、8.4は容量・CPU数で自動選択。
# innodb_buffer_pool_instances=2

# 適応ハッシュインデックス無効化 refs: https://inside.pixiv.blog/2021/10/21/154500
# 5.7/8.0では既定ON、8.4では既定OFF。競合があればOFFとONで比較。
# innodb_adaptive_hash_index=OFF

## 多コア・高QPSで「本当に」I/O待ちが顕著な時だけ（要ベンチ）
# スレッド数を増やせば常に速くなるわけではない。
# innodb_write_io_threads=8
# innodb_read_io_threads=8

# 書込み負荷でpage cleanerの処理が問題ならLRU走査量も検討（既定1024）。
# innodb_lru_scan_depth=256

# AUTO_INCREMENTを使うINSERTの競合が顕著な場合。
# 5.7では既定1、8.0.3以降は既定2。statement-based replication等との互換性に注意。
# innodb_autoinc_lock_mode=2
